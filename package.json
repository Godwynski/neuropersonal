{
  "name": "neuroptimize",
  "version": "1.0.0",
  "description": "System command and utility dashboard for Windows",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "build:exe": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "keywords": [],
  "author": "Neuroptimize Team",
  "license": "ISC",
  "build": {
    "appId": "com.neuroptimize.app",
    "productName": "Neuroptimize",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/logo.png",
      "requestedExecutionLevel": "requireAdministrator"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.14",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "^1.1.13",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
